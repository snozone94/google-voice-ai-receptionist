{
  "expo": {
    "name": "DDD AI Dispatch",
    "slug": "ddd-ai-dispatch",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "dddaidispatch",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dddcincy.aireceptionist",
      "buildNumber": "16",
      "entitlements": { "aps-environment": "production", "com.apple.developer.usernotifications.time-sensitive": true },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "DDD Dispatch uses your microphone for business phone calls."
      }
    },
    "android": {
      "package": "com.dddcincy.aireceptionist",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#7d4dff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "defaultApiBaseUrl": "https://google-voice-ai-receptionist.onrender.com",
      "eas": {
        "projectId": "1cb2854e-bd1b-48ab-9b00-85f1d7259ccc"
      }
    },
    "owner": "dddcincy",
    "plugins": [
      "@twilio/voice-react-native-sdk",
      "./withDddCallSounds.cjs",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ff3ea5",
          "defaultChannel": "ddd-dispatch",
          "sounds": [
            "./assets/ddd_dispatch_alert.wav",
            "./assets/ddd_roadside_ring.wav",
            "./assets/ddd_on_the_move.wav",
            "./assets/ddd_road_ready.wav",
            "./assets/ddd_keep_rolling.wav"
          ]
        }
      ]
    ]
  }
}
