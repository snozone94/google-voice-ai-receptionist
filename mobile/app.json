{
  "expo": {
    "name": "DDD AI Dispatch",
    "slug": "ddd-ai-dispatch",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "dddaidispatch",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dddcincy.aireceptionist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dddcincy.aireceptionist",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#7d4dff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "defaultApiBaseUrl": "https://google-voice-ai-receptionist.onrender.com",
      "eas": {
        "projectId": "1cb2854e-bd1b-48ab-9b00-85f1d7259ccc"
      }
    },
    "owner": "dddcincy"
  }
}
